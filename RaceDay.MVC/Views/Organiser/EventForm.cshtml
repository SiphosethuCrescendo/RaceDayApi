@model EventFormViewModel
@{
    var creating = Model.EventID == 0; ViewData["Title"] = creating ? "Create Event" : "Edit Event";
}
<h1>@ViewData["Title"]</h1>
<form asp-action="@(creating ? "CreateEvent" : "EditEvent")" method="post" enctype="multipart/form-data" class="card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="EventID" /><input type="hidden" asp-for="ImageUrl" />
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="col-md-6 mb-3">
            <label asp-for="EventType"></label>
            <select asp-for="EventType" class="form-select"><option>Run</option><option>Cycle</option><option>Trail</option><option>Swim</option></select>
        </div>
        <div class="col-12 mb-3"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="col-md-4 mb-3"><label asp-for="EventDate"></label><input asp-for="EventDate" type="datetime-local" class="form-control" /><span asp-validation-for="EventDate" class="text-danger"></span></div>
        <div class="col-md-4 mb-3"><label asp-for="Location"></label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger"></span></div>
        <div class="col-md-4 mb-3"><label asp-for="Distance"></label><input asp-for="Distance" class="form-control" /><span asp-validation-for="Distance" class="text-danger"></span></div>
        <div class="col-12 mb-3">
            <label>Banner image</label>
            <input type="file" name="banner" accept="image/*" class="form-control" />
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="mt-2" style="max-height:100px" alt="Current banner" />
            }
        </div>
    </div>
    <div><button class="btn btn-primary">Save</button> <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}